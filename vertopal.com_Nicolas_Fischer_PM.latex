% Text styles
\newcommand{\roletitle}[1]{%
  {\fontsize{12}{15}\selectfont\bfseries #1\par}
}

\newcommand{\metadata}[1]{%
  {\color{muted}\fontsize{10}{13}\selectfont #1\par}
}

\newcommand{\skills}[1]{%
  \vspace{8pt}
  {\fontsize{10}{13}\selectfont
   \(\diamond\)\ \textbf{#1}\par}
}

% Each role gets a timeline dot and vertical line.
% Use [last] for the final role, which has no line below it.
\newtcolorbox{role}[1][]{%
  enhanced,
  frame hidden,
  interior hidden,
  boxrule=0pt,
  sharp corners,
  boxsep=0pt,
  left=24pt,
  right=0pt,
  top=0pt,
  bottom=14pt,
  before skip=0pt,
  after skip=0pt,
  overlay={
    \draw[timeline,line width=2pt]
      ([xshift=7pt,yshift=-15pt]frame.north west)
      --
      ([xshift=7pt,yshift=5pt]frame.south west);
    \fill[dotgray]
      ([xshift=7pt,yshift=-7pt]frame.north west)
      circle[radius=2.5pt];
  },
  #1
}

\tcbset{
  last/.style={
    overlay={
      \draw[timeline,line width=2pt]
        ([xshift=7pt,yshift=-15pt]frame.north west)
        --
        ([xshift=7pt]frame.south west);
      \fill[dotgray]
        ([xshift=7pt,yshift=-7pt]frame.north west)
        circle[radius=2.5pt];
    }
  }
}

